---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  aspect?: string;
}
const {
  src,
  alt,
  caption = 'Ảnh demo / minh họa. Không phải công trình đã làm.',
  aspect = '16/9',
} = Astro.props;
const b = import.meta.env.BASE_URL;
const webp = src.endsWith('.webp') ? src : src.replace(/\.(png|jpg|jpeg)$/i, '.webp');
const jpg = webp.replace(/\.webp$/i, '.jpg');
---
<figure class="illust">
  <picture>
    <source srcset={`${b}${webp}`} type="image/webp" />
    <img src={`${b}${jpg}`} alt={alt} width="960" height="640" style={`aspect-ratio:${aspect};width:100%;object-fit:cover;border-radius:10px`} />
  </picture>
  <figcaption>{caption}</figcaption>
</figure>
