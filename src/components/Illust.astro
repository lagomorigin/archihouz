---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  aspect?: string;
}
const {
  src,
  alt,
  caption = 'Minh họa. Không phải việc đã làm.',
  aspect = '16/9',
} = Astro.props;
const b = import.meta.env.BASE_URL;
---
<figure class="illust">
  <img src={`${b}${src}`} alt={alt} width="960" height="640" style={`aspect-ratio:${aspect};width:100%;object-fit:cover;border-radius:10px`} />
  <figcaption>{caption}</figcaption>
</figure>
