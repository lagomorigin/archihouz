---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---
<section class="vat-lieu">
  <div class="wrap">
    <h2>Vật liệu dùng khi xem nhà</h2>
    <p>Loại nào dùng, chốt khi xem nhà. Dưới đây là ví dụ sản phẩm Seamax, không phải việc đã làm.</p>
    <div class="cards">
      {items.map((name) => (
        <article class="card">
          <div
            class="pack-shot"
            role="img"
            aria-label={`Ảnh sản phẩm Seamax ${name}. Không phải việc Archihouz đã làm.`}
          ></div>
          <h3>{name}</h3>
          <p class="note">Ảnh sản phẩm Seamax. Không phải công trình Archihouz.</p>
        </article>
      ))}
    </div>
  </div>
</section>
