---
interface Item {
  name: string;
  image: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const b = import.meta.env.BASE_URL;
const caption = (name: string) =>
  `Minh họa thùng ${name}. Không phải lon đóng gói thật. Không phải việc Archihouz đã làm.`;
---
<section class="vat-lieu">
  <div class="wrap">
    <h2>Vật liệu dùng khi khảo sát</h2>
    <p>Loại nào dùng, chốt lúc khảo sát. Dưới đây là ví dụ sản phẩm Seamax, không phải việc đã làm.</p>
    <div class="cards">
      {items.map((item) => (
        <article class="card">
          <img
            class="pack-shot"
            src={`${b}${item.image}`}
            alt={caption(item.name)}
            width="640"
            height="427"
          />
          <h3>{item.name}</h3>
          <p class="note">{caption(item.name)}</p>
        </article>
      ))}
    </div>
  </div>
</section>
