---
import Base from '../layouts/Base.astro';
const title = 'Chống thấm TP.HCM | Archihouz';
const description = 'Chống thấm nhà vệ sinh, sân thượng và tường tại TP.HCM. Có hợp đồng. Thử nước rồi giao.';
const b = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1>Chống thấm nhà phố tại TP.HCM</h1>
        <p>Có hợp đồng. Làm xong thử nước rồi mới giao.</p>
        <div class="cards">
          <a class="card" href={`${b}chong-tham-nha-ve-sinh/`}>
            <h2>Nhà vệ sinh</h2>
            <p>Sàn, ống, trần nhà dưới ố. Gửi ảnh Zalo.</p>
          </a>
          <a class="card" href={`${b}chong-tham-san-thuong/`}>
            <h2>Sân thượng</h2>
            <p>Sân nứt, đọng nước. Làm đúng chỗ nước vào.</p>
          </a>
          <a class="card" href={`${b}chong-tham-tuong/`}>
            <h2>Tường</h2>
            <p>Tường ẩm, ố. Thử nước rồi giao.</p>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
