---
import Base from '../layouts/Base.astro';
import ImgPlaceholder from '../components/ImgPlaceholder.astro';
import Illust from '../components/Illust.astro';
import { ZALO_HREF, PHONE_HREF, SO_TAM } from '../site';
const b = import.meta.env.BASE_URL;
const title = 'Giới thiệu Archihouz | Sơn nhà & chống thấm';
const description = 'Archihouz tư vấn và triển khai giải pháp sơn, chống thấm cho nhà ở và công trình dân dụng — bắt đầu từ câu hỏi ngôi nhà đang thực sự cần gì.';
---
<Base title={title} description={description}>
  <main>
    <section class="hero home">
      <div class="wrap wide">
        <div class="badge">Về Archihouz</div>
        <h1>Không chỉ là một lớp sơn. Đó là cách chúng ta bảo vệ một ngôi nhà.</h1>
        <Illust src="img/hero-gioi-thieu.webp" alt="Ảnh demo / minh họa. Không phải công trình đã làm." caption="Ảnh demo / minh họa. Không phải công trình đã làm." aspect="16/9" />
        <p>Một ngôi nhà đẹp có thể bắt đầu từ một màu sơn. Nhưng để ngôi nhà luôn đẹp qua năm tháng, điều quan trọng hơn là được bảo vệ đúng cách ngay từ đầu. Đó là lý do Archihouz ra đời.</p>
        <p>Chúng tôi mang đến các giải pháp sơn nhà, chống thấm và hoàn thiện công trình, với mong muốn giúp mỗi gia đình có một không gian không chỉ đẹp ở hiện tại, mà còn bền vững và an tâm trong những năm tháng về sau.</p>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Chúng tôi bắt đầu bằng câu hỏi đúng</h2>
        <p>Archihouz là đơn vị tư vấn và triển khai các giải pháp sơn, chống thấm cho nhà ở và công trình dân dụng. Chúng tôi không bắt đầu bằng việc hỏi: “Bạn muốn sơn màu gì?” mà bắt đầu bằng câu hỏi “Ngôi nhà của bạn đang thực sự cần gì?” — bởi mỗi công trình đều có một câu chuyện khác nhau.</p>
        <ul>
          <li>Có ngôi nhà cần một lớp sơn mới để trở nên tươi sáng hơn.</li>
          <li>Có công trình cần xử lý thấm trước khi mọi thứ trở nên nghiêm trọng.</li>
          <li>Có những bức tường đã xuống cấp và cần được phục hồi.</li>
          <li>Có những gia đình đơn giản chỉ cần một người tư vấn đúng và làm thật.</li>
        </ul>
        <p>Archihouz ở đó lắng nghe, khảo sát và cùng khách hàng tìm ra giải pháp phù hợp nhất.</p>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Chúng tôi tin rằng…</h2>
        <p>Một ngôi nhà đẹp phải bắt đầu từ một nền tảng tốt. Sơn không chỉ để tạo màu. Chống thấm không chỉ để xử lý một vết ẩm. Một công trình được chăm sóc đúng cách là sự kết hợp của vật liệu phù hợp, giải pháp đúng, kỹ thuật chuẩn và sự cẩn trọng trong từng bước thực hiện.</p>
        <p>Vì vậy Archihouz luôn nhìn công trình từ bên trong và bên ngoài — từ vấn đề cần giải quyết đến kết quả khách hàng mong muốn.</p>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Từ một vấn đề nhỏ đến một giải pháp đúng</h2>
        <div class="steps">
          <div class="step"><div class="n">1</div><p><strong>Nhìn đúng vấn đề</strong> — Khảo sát thực tế để hiểu tình trạng và nguyên nhân.</p></div>
          <div class="step"><div class="n">2</div><p><strong>Chọn đúng giải pháp</strong> — Phương án phù hợp hiện trạng, nhu cầu và ngân sách.</p></div>
          <div class="step"><div class="n">3</div><p><strong>Dùng đúng vật liệu</strong> — Sản phẩm từ thương hiệu phù hợp từng hạng mục.</p></div>
          <div class="step"><div class="n">4</div><p><strong>Làm đúng kỹ thuật</strong> — Kiểm soát từng bước thi công để giải pháp phát huy đúng hiệu quả.</p></div>
          <div class="step"><div class="n">5</div><p><strong>Đồng hành sau công trình</strong> — Không kết thúc mối quan hệ ngay khi hoàn thành công việc.</p></div>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Archihouz cung cấp các dịch vụ gì?</h2>
        <div class="cards grid-2">
          <a class="card" href={`${b}son-nha-tron-goi/`}><strong>Sơn nhà</strong><p class="card-desc">Mang màu sắc và diện mạo mới đến không gian sống</p></a>
          <a class="card" href={`${b}chong-tham-tuong/`}><strong>Chống thấm</strong><p class="card-desc">Bảo vệ công trình trước thời tiết và độ ẩm</p></a>
          <div class="card"><strong>Sửa chữa &amp; cải tạo</strong><p class="card-desc">Phục hồi bề mặt xuống cấp, cũ kỹ</p></div>
          <div class="card"><strong>Tư vấn &amp; giải pháp</strong><p class="card-desc">Phương án phù hợp thay vì công thức có sẵn</p></div>
          <div class="card"><strong>Thi công trọn gói</strong><p class="card-desc">Từ khảo sát, tư vấn đến thi công và hoàn thiện</p></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Điều đặc biệt làm nên “chất” riêng của Archihouz</h2>
        <div class="criteria">
          <article><h3>Không tư vấn theo một công thức cho tất cả</h3><p>Một căn nhà phố khác một biệt thự. Một bức tường mới khác một bề mặt đã xuống cấp. Một vấn đề thấm mới khác một công trình đã xử lý nhiều lần. Giải pháp phải bắt đầu từ hiện trạng thực tế.</p></article>
          <article><h3>Không chỉ bán sản phẩm</h3><p>Archihouz tập trung vào giải pháp tổng thể: từ khảo sát, lựa chọn vật liệu đến phương án thi công.</p></article>
          <article><h3>Không chỉ hoàn thành một công trình</h3><p>Điều chúng tôi hướng đến là kết quả khiến khách hàng yên tâm sử dụng ngôi nhà trong thời gian dài.</p></article>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Mỗi công trình là một lời cam kết</h2>
        <p>Từ những bức tường cũ, một mái nhà bị thấm hay một căn nhà cần khoác diện mạo mới… Điều cuối cùng khách hàng nhìn thấy không phải là quy trình chúng tôi đã làm — mà là một ngôi nhà đẹp hơn, được bảo vệ tốt hơn và cảm giác an tâm hơn.</p>
        <h2 style="margin-top:1.25rem">Không chỉ bảo vệ ngôi nhà, chúng tôi bảo vệ giá trị của nó</h2>
        <p>Archihouz tin rằng mỗi ngôi nhà đều xứng đáng được chăm sóc bằng một giải pháp phù hợp. Và mỗi khách hàng đều xứng đáng nhận được sự tư vấn rõ ràng, thi công chỉn chu và trách nhiệm đến cùng. Đó là cách Archihouz làm nghề.</p>
      </div>
    </section>

    <section id="tu-van">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Ngôi nhà của bạn đang cần được chăm sóc?</h2>
        <p>Khảo sát tận nơi hoàn toàn miễn phí. Hãy để Archihouz đến tận nơi, lắng nghe vấn đề và cùng bạn tìm ra giải pháp phù hợp.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Đăng ký khảo sát</a>
          <a class="btn btn-ghost" href={`${b}lien-he/`}>Liên hệ Archihouz</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
        </div>
      </div>
    </section>
  </main>
</Base>
