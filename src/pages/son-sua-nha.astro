---
import Base from '../layouts/Base.astro';
import VatLieuSlot from '../components/VatLieuSlot.astro';
import { ZALO_HREF, PHONE_HREF } from '../site';
const b = import.meta.env.BASE_URL;
const title = 'Sơn sửa nhà TP.HCM | Có hợp đồng, xem nhà rồi mới báo giá, Archihouz';
const description = 'Tường hỏng, sơn bong, muốn sửa rồi sơn lại một mối? Gửi ảnh Zalo. Qua xem nhà rồi mới báo giá. Có hợp đồng.';
---
<Base title={title} description={description}>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1>Nhà cần sửa rồi sơn. Một hợp đồng, xem nhà rồi mới báo giá.</h1>
        <figure class="illust">
          <img src={`${b}img/hero-son-sua-nha.png`} alt="Minh họa. Nứt nhỏ, mảng vỡ. Không phải nhà đã làm." width="960" height="640" />
          <figcaption>Minh họa. Nứt nhỏ, mảng vỡ. Không phải nhà đã làm.</figcaption>
        </figure>
        <p>Tường nứt nhỏ, sơn bong, góc ẩm. Muốn một mối sửa rồi sơn, đừng gọi hai thợ nói miệng.</p>
        <p>Archihouz nhận sơn sửa nhà có hợp đồng. Qua nhà xem rồi mới báo giá.</p>
        <p><strong>Nhắn Zalo:</strong> gửi ảnh chỗ hỏng và quận. Mình hẹn ngày qua xem nhà.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi ngay</a>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <h2>Hay gặp</h2>
        <ul>
          <li>Sửa một nơi, sơn một nơi, lệch màu, lệch việc.</li>
          <li>Thợ sửa xong bỏ, thợ sơn bảo không phải việc mình.</li>
          <li>Giá rẻ lúc đầu, đục ra thành tiền khác.</li>
        </ul>
        <p>Mình qua xem tại nhà. Phần sửa và phần sơn ghi trên một hợp đồng. Có thêm việc thì nói trước khi làm.</p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Gói này làm gì</h2>
        <p>Sơn sửa nhà phố: xử lý chỗ hỏng nhỏ trên tường/trần rồi sơn lại. Phạm vi chốt khi xem nhà.</p>
        <p>Sơn dùng <strong>Seamax</strong>. Loại nào dùng, chốt khi xem nhà.</p>
        <p>Gói này <strong>không gồm:</strong> chống thấm sân thượng, chống thấm nhà vệ sinh, sơn mặt tiền khi tường còn thấm. Việc chống thấm làm trang riêng, không nhét vào gói sơn sửa cho xong.</p>
        <p>Mùa mưa: sửa được thì sửa; sơn khi mặt đủ khô.</p>
      </div>
    </section>

    <VatLieuSlot items={[
      { name: 'Seamax Primer In', image: 'img/pack-seamax-primer-in.png' },
      { name: 'Seamax Primer Alkaline', image: 'img/pack-seamax-primer-alkaline.png' },
      { name: 'Seamax Super Gloss Nano', image: 'img/pack-seamax-super-gloss-nano.png' },
    ]} />

    <section class="alt">
      <div class="wrap">
        <h2>Làm thế nào</h2>
        <ol>
          <li>Gửi ảnh Zalo và quận.</li>
          <li>Qua xem nhà.</li>
          <li>Hợp đồng: công ty, làm phần nào, bảo hành có điều kiện, ghi trên giấy hợp đồng. Có hóa đơn nếu anh/chị cần.</li>
          <li>Sửa rồi sơn đúng phần đã ký.</li>
          <li>Giao nhà.</li>
        </ol>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Bảo hành</h2>
        <p>Bảo hành <strong>có điều kiện, ghi trên giấy hợp đồng</strong>. Không nói miệng. Trang này không ghi số năm.</p>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <h2>Hỏi nhanh</h2>
        <dl class="faq">
          <dt>Chống thấm luôn trong gói này?</dt>
          <dd>Không. Chống thấm nhà vệ sinh, sân, tường là trang khác.</dd>
          <dt>Đang mưa làm được không?</dt>
          <dd>Qua xem vẫn hẹn. Sơn thì tùy mặt khô.</dd>
          <dt>Có phải Seamaster?</dt>
          <dd>Không. Mình dùng <strong>Seamax</strong>.</dd>
        </dl>
      </div>
    </section>

    <section id="nhan-zalo">
      <div class="wrap">
        <h2>Nhắn Zalo</h2>
        <p>Nhà cần sửa rồi sơn thì gửi ảnh.</p>
        <p class="note">Để lại: Sơn sửa nhà / Quận / Ảnh / Zalo.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi ngay</a>
        </div>
      </div>
    </section>
  </main>
</Base>
