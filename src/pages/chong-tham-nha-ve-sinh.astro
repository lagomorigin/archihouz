---
import Base from '../layouts/Base.astro';
import VatLieuSlot from '../components/VatLieuSlot.astro';
import { ZALO_HREF, PHONE_HREF } from '../site';
const title = 'Chống thấm nhà vệ sinh TP.HCM — Archihouz';
const description = 'Trần dưới ố vì vệ sinh thấm? Archihouz khảo sát tận nơi, làm đúng chỗ nước vào. Làm xong cho nước vào kiểm tra; thấy ổn mới bàn giao nhà.';
const b = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1>Trần dưới đang ố vì nhà vệ sinh thấm?</h1>
        <figure class="illust">
          <img src={`${b}img/hero-chong-tham-nha-ve-sinh.webp`} alt="Minh họa. Sàn ướt, trần nhà dưới ố. Không phải công trình đã làm." width="960" height="640" />
          <figcaption>Minh họa. Sàn ướt, trần nhà dưới ố. Không phải công trình đã làm.</figcaption>
        </figure>
        <p>Mưa một trận là lại thấp thỏm.</p>
        <p>Trần nhà dưới ố vàng. Sàn vệ sinh ẩm. Anh/chị bước vào nhà là thấy, đêm mưa lại khó ngủ yên.</p>
        <p>Archihouz hiểu cảm giác đó — mệt vì đã làm tạm rồi vẫn ẩm, sợ lần sau lại tốn tiền mà không hết.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi ngay</a>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <h2>Vì sao dễ thấm lại</h2>
        <p>Nhà vệ sinh thấm lâu thường không phải vì thiếu một lớp sơn.</p>
        <p>Nước hay len từ chỗ ống xuyên sàn, từ khe gạch, hoặc chân tường. Chỉ phủ mặt mà bỏ những chỗ đó thì tuần sau vẫn ẩm — đó là lý do nhiều nhà làm đi làm lại.</p>
        <p>Chúng tôi tìm đúng nguồn nước trước, rồi mới chọn cách làm.</p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Archihouz làm thế nào</h2>
        <p>Archihouz làm việc có hợp đồng công ty.</p>
        <p><strong>Khảo sát tận nơi</strong> — tìm chỗ nước vào, nói rõ có cần đục gạch hay không, rồi mới báo giá. Không đoán giá trên chat.</p>
        <p>Phạm vi chúng tôi nhận: sàn vệ sinh, chân tường, chỗ ống xuyên sàn. Sơn chống thấm dùng <strong>Seamax</strong>; loại nào hợp chọn lúc khảo sát.</p>
        <p>Không gồm ốp lại cả phòng, sơn trần tầng dưới, hay sơn mặt tiền. Cần thêm, chúng tôi nói rõ và làm riêng.</p>
        <p>Làm xong chúng tôi cho nước vào kiểm tra; thấy ổn mới bàn giao nhà.</p>
        <p>Bảo hành phần nào được ghi trên hợp đồng, có điều kiện — không chỉ bằng lời. Trang này không ghi số năm bảo hành.</p>
        <p>Phí khảo sát: lúc hẹn chúng tôi nói rõ. Bao lâu xong: sau khi khảo sát mới nói được.</p>
      </div>
    </section>

    <VatLieuSlot items={[
      { name: 'Seamax CT-11A', image: 'img/pack-seamax-ct-11a.webp' },
      { name: 'Seamax PU gốc nước', image: 'img/pack-seamax-pu-goc-nuoc.webp' },
    ]} />

    <section class="alt" id="nhan-zalo">
      <div class="wrap">
        <h2>Nhắn Zalo</h2>
        <p>Khi anh/chị sẵn sàng, gửi giúp 1–2 ảnh chỗ thấm và cho biết đang ở khu vực nào (TP.HCM) qua Zalo. Archihouz xem ảnh rồi hẹn ngày khảo sát.</p>
        <p>Trần đang ố thì đừng chờ trận mưa sau.</p>
        <p class="note">Để lại: Nhà vệ sinh / Khu vực / Ảnh / Zalo.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi ngay</a>
        </div>
      </div>
    </section>
  </main>
</Base>
