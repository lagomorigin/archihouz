---
import Base from '../layouts/Base.astro';
import ImgPlaceholder from '../components/ImgPlaceholder.astro';
import Illust from '../components/Illust.astro';
import { ZALO_HREF, PHONE_HREF, SO_TAM } from '../site';
const title = 'Chống thấm tường TP.HCM | Archihouz';
const description = 'Tường ố vàng, bong tróc, mốc ẩm hoặc mưa lại thấm? Archihouz khảo sát tận nơi, bắt đúng nguyên nhân, thi công trọn gói, báo giá rõ ràng.';
---
<Base title={title} description={description}>
  <main>
    <section class="hero home">
      <div class="wrap wide">
        <div class="badge">Chống thấm tường</div>
        <h1>Chống thấm tường: bắt bệnh chuẩn, xử lý từ gốc, bao trọn — không phát sinh</h1>
        <p>Tường ố vàng, bong tróc, mốc ẩm hoặc cứ mưa là thấm lại? Archihouz khảo sát tận nơi, tìm nguyên nhân nước xâm nhập và đưa ra phương án phù hợp với hiện trạng — thi công trọn gói, rõ từng hạng mục, không vẽ thêm chi phí.</p>
        <Illust src="img/hero-chong-tham-tuong.webp" alt="Minh họa. Nước vào từ khe, chân tường. Không phải công trình đã làm." caption="Minh họa tường thấm. Không phải công trình đã làm." />
        <p><strong>Cam kết từ Archihouz:</strong></p>
        <ul class="check-list">
          <li>Khảo sát tận nơi miễn phí</li>
          <li>Bắt đúng nguyên nhân trước khi xử lý</li>
          <li>Thi công chuẩn kỹ thuật</li>
          <li>Bao trọn phần việc cần làm</li>
          <li>Báo giá rõ ràng, không phát sinh</li>
        </ul>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Đăng ký khảo sát miễn phí</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Tường thấm không đáng ngại bằng việc xử lý sai rồi phải làm lại</h2>
        <p><strong>Những gì chủ nhà thường nhìn thấy:</strong></p>
        <ul>
          <li>Tường trong nhà ố vàng sau mỗi trận mưa.</li>
          <li>Lớp sơn bong tróc, phồng rộp mất thẩm mỹ.</li>
          <li>Góc tường mốc đen, ẩm thấp khó chịu.</li>
          <li>Tường ngoài xuất hiện vết nứt chân chim hoặc nứt nẻ lớn.</li>
          <li>Nước rỉ, thấm róc rách qua khe cửa sổ.</li>
          <li>Tường giáp nhà bên cạnh luôn ẩm ướt.</li>
          <li>Toàn bộ mặt tiền xuống cấp trầm trọng.</li>
        </ul>
        <p><strong>Điều chủ nhà thực sự lo lắng:</strong></p>
        <p><em>“Chống thấm đợt này xong… rồi vài tháng sau có bị thấm lại không?”</em></p>
        <p>Không ai muốn rơi vào cảnh vừa bỏ một khoản tiền lớn để cạo sơn, trét bả, quét chống thấm xong, chỉ vài cơn mưa sau lại thấy tường ố, mốc, bong tróc như cũ.</p>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Hiểu đúng về chống thấm</h2>
        <ImgPlaceholder label="Minh họa đường nước vào — chờ Linh" aspect="16/9" />
        <p>Chống thấm không chỉ là bôi một lớp vật liệu để tường tạm thời hết thấm ở thời điểm hiện tại. Bản chất của chống thấm là phải tìm hiểu xem nước đang đi vào từ đâu và vì sao nó có thể quay trở lại — để chặn đứng hoàn toàn chu trình đó.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
        </div>
      </div>
    </section>
  </main>
</Base>
