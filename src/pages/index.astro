---
import Base from '../layouts/Base.astro';
import { ZALO_HREF, PHONE_HREF, SO_TAM } from '../site';
const title = 'Archihouz | Sơn sửa nhà và chống thấm TP.HCM';
const description = 'Archihouz nhận sơn nhà, sơn sửa nhà và chống thấm tại TP.HCM. Qua xem nhà rồi báo giá. Có hợp đồng.';
const b = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <main>
    <section class="hero home">
      <div class="wrap">
        <div class="badge">TP.HCM · Chống thấm &amp; sơn nhà</div>
        <h1>Nhà đang thấm hoặc cần sơn lại?</h1>
        <p>Archihouz khảo sát tận nơi, làm đúng chỗ nước vào. Có hợp đồng công ty. Làm xong cho nước vào kiểm tra; thấy ổn mới bàn giao.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi ngay</a>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Chọn hạng mục</h2>
        <div class="cards grid-2">
          <a class="card" href={`${b}chong-tham-nha-ve-sinh/`}>
            <img class="icon" src={`${b}img/icon-nha-ve-sinh.webp`} alt="" width="40" height="40" />
            <strong>Nhà vệ sinh</strong>
            <p class="card-desc">Trần dưới ố, sàn ẩm</p>
          </a>
          <a class="card" href={`${b}chong-tham-san-thuong/`}>
            <img class="icon" src={`${b}img/icon-san-thuong.webp`} alt="" width="40" height="40" />
            <strong>Sân thượng</strong>
            <p class="card-desc">Đọng nước, thấm xuống</p>
          </a>
          <a class="card" href={`${b}chong-tham-tuong/`}>
            <img class="icon" src={`${b}img/icon-tuong-tham.webp`} alt="" width="40" height="40" />
            <strong>Tường thấm</strong>
            <p class="card-desc">Ẩm tường, sơn bong</p>
          </a>
          <a class="card" href={`${b}son-nha/`}>
            <img class="icon" src={`${b}img/icon-son-nha.webp`} alt="" width="40" height="40" />
            <strong>Sơn nhà</strong>
            <p class="card-desc">Sơn lại cho đẹp</p>
          </a>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <h2>Cách Archihouz làm</h2>
        <div class="steps">
          <div class="step"><div class="n">1</div><p>Gửi ảnh + khu vực qua Zalo</p></div>
          <div class="step"><div class="n">2</div><p>Khảo sát tận nơi, báo giá trên giấy</p></div>
          <div class="step"><div class="n">3</div><p>Thi công đúng chỗ — cho nước vào kiểm tra rồi bàn giao</p></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Sẵn sàng nhắn?</h2>
        <p class="note">Gửi ảnh chỗ thấm hoặc chỗ cần sơn. Archihouz hẹn khảo sát.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
        </div>
      </div>
    </section>
  </main>
</Base>
