      <script is:inline>
        (function () {
          var grid = document.getElementById('situ-grid');
          var btn = document.getElementById('situ-more');
          if (!grid || !btn) return;
          btn.addEventListener('click', function () {
            var open = grid.getAttribute('data-collapsed') !== 'true';
            if (open) {
              grid.setAttribute('data-collapsed', 'true');
              btn.setAttribute('aria-expanded', 'false');
              btn.textContent = 'Xem thêm';
              grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } else {
              grid.setAttribute('data-collapsed', 'false');
              btn.setAttribute('aria-expanded', 'true');
              btn.textContent = 'Thu gọn';
            }
          });
        })();
      </script>
