---
import Base from '../layouts/Base.astro';
import ImgPlaceholder from '../components/ImgPlaceholder.astro';
import Illust from '../components/Illust.astro';
import { ZALO_HREF, PHONE_HREF, SO_TAM } from '../site';
const title = 'Archihouz | Sơn nhà & chống thấm TP.HCM';
const description = 'Archihouz tư vấn và thi công sơn nhà, chống thấm, cải tạo nhà ở tại TP.HCM. Khảo sát tận nơi, báo giá rõ ràng.';
const b = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <main>
    <section class="hero home">
      <div class="wrap wide">
        <div class="badge">Công ty TNHH Xây dựng Trang trí Nội thất CNC Decor</div>
        <p class="micro">Hotline / Zalo: <a href={PHONE_HREF}>{SO_TAM}</a></p>
        <h1>Sơn nhà · Chống thấm · Cải tạo nhà ở</h1>
        <p>Archihouz đồng hành làm đẹp và bảo vệ ngôi nhà — chỉn chu từng công đoạn, chất lượng công trình và sự hài lòng của khách hàng là tiêu chuẩn cho mỗi dự án.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Dịch vụ</h2>
        <div class="cards grid-2">
          <a class="card" href={`${b}son-nha-tron-goi/`}><strong>Sơn nhà trọn gói</strong><p class="card-desc">Từ khảo sát đến lớp sơn cuối</p></a>
          <a class="card" href={`${b}son-lai-nha-cu/`}><strong>Sơn lại nhà cũ</strong><p class="card-desc">Xử lý bề mặt trước khi sơn mới</p></a>
          <a class="card" href={`${b}chong-tham-tuong/`}><strong>Chống thấm tường</strong><p class="card-desc">Bắt đúng nguyên nhân, xử lý từ gốc</p></a>
          <div class="card"><strong>Sơn nội thất</strong><p class="card-desc">Không gian trong nhà</p></div>
          <div class="card"><strong>Sơn ngoại thất</strong><p class="card-desc">Mặt tiền, tường ngoài</p></div>
          <div class="card"><strong>Cải tạo nhà ở</strong><p class="card-desc">Phục hồi bề mặt xuống cấp</p></div>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Những con số ấn tượng</h2>
        <p>Với đội ngũ thi công giàu kinh nghiệm trong lĩnh vực sơn nhà và chống thấm, Archihouz đã đồng hành cùng hàng nghìn khách hàng trong việc làm đẹp và bảo vệ ngôi nhà. Chúng tôi đặt sự chỉn chu trong từng công đoạn, chất lượng công trình và sự hài lòng của khách hàng làm tiêu chuẩn cho mỗi dự án.</p>
        <div class="stats">
          <div class="stat"><span class="num">750+</span><span class="lbl">Công trình sơn nhà</span></div>
          <div class="stat"><span class="num">350+</span><span class="lbl">Công trình chống thấm</span></div>
          <div class="stat"><span class="num">1.000+</span><span class="lbl">Khách hàng đã tin chọn</span></div>
          <div class="stat"><span class="num">95%+</span><span class="lbl">Khách hàng hài lòng</span></div>
          <div class="stat"><span class="num">98%+</span><span class="lbl">Công trình đúng tiến độ</span></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Tiêu chí hoạt động</h2>
        <p>Chúng tôi hoạt động với những tiêu chí rõ ràng từ tư vấn đến thi công để giữ chữ tín với khách hàng. Dưới đây là 6 giá trị khi chọn đồng hành cùng Archihouz.</p>
        <div class="criteria">
          <article><h3>01. Báo giá rõ ràng – Hạn chế tối đa phát sinh</h3><p>Các hạng mục thi công, vật liệu, khối lượng và chi phí được trao đổi rõ ràng trước khi thực hiện. Ưu tiên minh bạch để khách hàng chủ động kiểm soát ngân sách.</p></article>
          <article><h3>02. Cân đối giải pháp theo ngân sách</h3><p>Tư vấn và cân đối phương án thi công, vật liệu và phạm vi công việc dựa trên ngân sách thực tế — hướng đến giải pháp phù hợp thay vì tư vấn vượt nhu cầu.</p></article>
          <article><h3>03. Khảo sát thực tế – Tư vấn đúng nhu cầu</h3><p>Khảo sát hiện trạng để xác định nguyên nhân, mức độ và đặc điểm từng khu vực. Đưa ra giải pháp phù hợp thay vì một phương án chung.</p></article>
          <article><h3>04. Vật liệu rõ ràng – Lựa chọn có cơ sở</h3><p>Tư vấn chủng loại, tính năng và phạm vi sử dụng của từng sản phẩm, giúp khách hàng hiểu mình đang đầu tư vào đâu.</p></article>
          <article><h3>05. Thi công chú trọng nền tảng</h3><p>Với chống thấm và sơn sửa, xử lý bề mặt trước khi hoàn thiện có vai trò quan trọng. Archihouz chú trọng từng bước xử lý để đảm bảo chất lượng và độ bền.</p></article>
          <article><h3>06. Đồng hành có trách nhiệm</h3><p>Theo sát từ khảo sát, tư vấn, báo giá đến thi công và hoàn thiện — trải nghiệm dịch vụ rõ ràng và an tâm.</p></article>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Quy trình làm việc</h2>
        <p>Từ tiếp nhận nhu cầu đến hoàn thiện, Archihouz thực hiện theo quy trình rõ ràng để khách hàng dễ theo dõi và kiểm soát chất lượng.</p>
        <div class="steps">
          <div class="step"><div class="n">1</div><p><strong>Tiếp nhận nhu cầu</strong> — Lắng nghe mong muốn và vấn đề đang gặp để xác định đúng yêu cầu.</p></div>
          <div class="step"><div class="n">2</div><p><strong>Khảo sát &amp; đánh giá</strong> — Kiểm tra hiện trạng bề mặt, xuống cấp hoặc thấm dột trước khi đề xuất.</p></div>
          <div class="step"><div class="n">3</div><p><strong>Tư vấn giải pháp &amp; báo giá</strong> — Phương án phù hợp về kỹ thuật, vật liệu, thẩm mỹ và ngân sách. Báo giá rõ trước khi triển khai.</p></div>
          <div class="step"><div class="n">4</div><p><strong>Chuẩn bị &amp; thi công</strong> — Chuẩn bị bề mặt, vật tư và khu vực theo đúng quy trình.</p></div>
          <div class="step"><div class="n">5</div><p><strong>Kiểm tra &amp; nghiệm thu</strong> — Kiểm tra chất lượng, hoàn thiện và nghiệm thu trước bàn giao.</p></div>
          <div class="step"><div class="n">6</div><p><strong>Bàn giao &amp; bảo hành</strong> — Bàn giao, hướng dẫn bảo quản và thực hiện bảo hành theo thỏa thuận.</p></div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Hình ảnh công trình</h2>
        <div class="ph-grid">
          {[
            ['img/hero-son-nha.webp','Minh họa sơn nhà'],
            ['img/hero-son-sua-nha.webp','Minh họa sơn sửa'],
            ['img/hero-chong-tham-tuong.webp','Minh họa tường thấm'],
            ['img/hero-chong-tham-nha-ve-sinh.webp','Minh họa WC'],
            ['img/icon-son-nha.webp','Minh họa icon sơn'],
            ['img/icon-tuong-tham.webp','Minh họa icon tường'],
          ].map(([src,alt]) => (
            <Illust src={src} alt={`${alt}. Không phải việc đã làm.`} caption="Minh họa. Không phải việc đã làm." aspect="4/3" />
          ))}}
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Cam kết của chúng tôi</h2>
        <p>Với mỗi công trình, Archihouz cam kết về chất lượng thi công, trải nghiệm và quyền lợi của khách hàng.</p>
        <div class="criteria">
          <article><h3>01. Đúng những gì đã thống nhất</h3><p>Phạm vi công việc, vật tư, chi phí và tiến độ được thống nhất rõ trước khi thi công.</p></article>
          <article><h3>02. Không phát sinh tùy tiện</h3><p>Mọi thay đổi hoặc chi phí phát sinh (nếu có) đều trao đổi và thống nhất trước khi thực hiện.</p></article>
          <article><h3>03. Đảm bảo chất lượng công trình</h3><p>Kiểm tra và nghiệm thu trước bàn giao, đảm bảo hạng mục đúng yêu cầu đã cam kết.</p></article>
          <article><h3>04. Bảo hành rõ ràng</h3><p>Chính sách bảo hành được thể hiện rõ và Archihouz thực hiện trách nhiệm sau bàn giao.</p></article>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Khu vực phục vụ</h2>
        <p>Archihouz phục vụ sơn nhà, chống thấm và cải tạo nhà ở tại TP. Hồ Chí Minh và các khu vực lân cận — khảo sát tận nơi miễn phí.</p>
        <div class="chips">
          {['TP. Hồ Chí Minh','Nhà Bè','Cần Giờ','Củ Chi','Bình Dương','Long An','Đồng Nai','Vũng Tàu','Cần Thơ'].map((a) => (
            <span class="chip">{a} — Hotline: {SO_TAM}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Thương hiệu chúng tôi sử dụng</h2>
        <p>Archihouz lựa chọn các thương hiệu sơn uy tín. Tùy nhu cầu, hiện trạng và ngân sách, chúng tôi tư vấn sản phẩm phù hợp — vật tư đúng theo thỏa thuận với khách hàng.</p>
        <div class="chips">
          {['Dulux','Jotun','Nippon Paint','KOVA','TOA','Seamax','Spec','Maxilite'].map((br) => (
            <span class="chip">{br}</span>
          ))}
        </div>
      </div>
    </section>

    <section id="tu-van">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Bạn cần tư vấn sơn nhà, chống thấm, cải tạo?</h2>
        <p>Cách nhanh nhất: liên hệ trực tiếp qua Zalo hoặc gọi điện.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
        </div>
      </div>
    </section>
  </main>
</Base>
