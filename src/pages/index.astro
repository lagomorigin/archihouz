---
import Base from '../layouts/Base.astro';
import Illust from '../components/Illust.astro';
import { ZALO_HREF, PHONE_HREF, SO_TAM } from '../site';
const title = 'Archihouz | Sơn nhà & chống thấm TP.HCM';
const description = 'Archihouz tư vấn và thi công sơn nhà, chống thấm, cải tạo nhà ở tại TP.HCM. Khảo sát tận nơi, báo giá rõ ràng.';
const b = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <main>
    <section class="hero-split-section hero-bleed" aria-label="Giới thiệu">
      <div class="hero-split">
        <figure class="hero-visual">
          <picture>
            <source srcset={`${b}img/hero-trang-chu-bleed.webp`} type="image/webp" />
            <img
              src={`${b}img/hero-trang-chu-bleed.jpg`}
              alt="Ảnh demo / minh họa. Không phải công trình đã làm."
              width="2400"
              height="900"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
          <figcaption class="sr-only">Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
        </figure>
        <div class="hero-panel">
          <div class="badge">Công ty TNHH Xây dựng Trang trí Nội thất CNC Decor</div>
          <h1>Sơn nhà · Chống thấm · Cải tạo nhà ở</h1>
          <p>Archihouz đồng hành làm đẹp và bảo vệ ngôi nhà — chỉn chu từng công đoạn, chất lượng công trình và sự hài lòng của khách hàng là tiêu chuẩn cho mỗi dự án.</p>
          <ul class="check-list">
            <li>Sơn nhà trọn gói</li>
            <li>Sơn lại nhà cũ</li>
            <li>Chống thấm tường</li>
            <li>Sơn nội thất &amp; ngoại thất</li>
            <li>Cải tạo nhà ở</li>
            <li>Khảo sát tận nơi, báo giá rõ ràng</li>
          </ul>
          <div class="cta-row">
            <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
            <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap wide svc-about">
        <div>
          <span class="bar"></span>
          <h2>Dịch vụ</h2>
          <div class="svc-grid">
            <a class="card" href={`${b}son-nha-tron-goi/`}>
              <picture>
              <source srcset={`${b}img/icon-son-nha.webp`} type="image/webp" />
              <img class="icon" src={`${b}img/icon-son-nha.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="80" height="80" decoding="async" />
            </picture>
              <strong>Sơn nhà trọn gói</strong><p class="card-desc">Từ khảo sát đến lớp sơn cuối</p>
            </a>
            <a class="card" href={`${b}son-lai-nha-cu/`}>
              <picture>
              <source srcset={`${b}img/icon-son-sua-nha.webp`} type="image/webp" />
              <img class="icon" src={`${b}img/icon-son-sua-nha.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="80" height="80" decoding="async" />
            </picture>
              <strong>Sơn lại nhà cũ</strong><p class="card-desc">Xử lý bề mặt trước khi sơn mới</p>
            </a>
            <a class="card" href={`${b}chong-tham-tuong/`}>
              <picture>
              <source srcset={`${b}img/icon-tuong-tham.webp`} type="image/webp" />
              <img class="icon" src={`${b}img/icon-tuong-tham.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="80" height="80" decoding="async" />
            </picture>
              <strong>Chống thấm tường</strong><p class="card-desc">Bắt đúng nguyên nhân, xử lý từ gốc</p>
            </a>
            <div class="card">
              <picture>
              <source srcset={`${b}img/icon-son-nha.webp`} type="image/webp" />
              <img class="icon" src={`${b}img/icon-son-nha.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="80" height="80" decoding="async" />
            </picture>
              <strong>Sơn nội thất</strong><p class="card-desc">Không gian trong nhà</p>
            </div>
            <div class="card">
              <picture>
              <source srcset={`${b}img/icon-san-thuong.webp`} type="image/webp" />
              <img class="icon" src={`${b}img/icon-san-thuong.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="80" height="80" decoding="async" />
            </picture>
              <strong>Sơn ngoại thất</strong><p class="card-desc">Mặt tiền, tường ngoài</p>
            </div>
            <div class="card">
              <picture>
              <source srcset={`${b}img/icon-nha-ve-sinh.webp`} type="image/webp" />
              <img class="icon" src={`${b}img/icon-nha-ve-sinh.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="80" height="80" decoding="async" />
            </picture>
              <strong>Cải tạo nhà ở</strong><p class="card-desc">Phục hồi bề mặt xuống cấp</p>
            </div>
          </div>
        </div>
        <div class="about-teaser">
          <span class="bar"></span>
          <h2>Về Archihouz</h2>
          <p>Một ngôi nhà đẹp có thể bắt đầu từ một màu sơn. Nhưng để ngôi nhà luôn đẹp qua năm tháng, điều quan trọng hơn là được bảo vệ đúng cách ngay từ đầu. Đó là lý do Archihouz ra đời.</p>
          <p>Chúng tôi mang đến các giải pháp sơn nhà, chống thấm và hoàn thiện công trình, với mong muốn giúp mỗi gia đình có một không gian không chỉ đẹp ở hiện tại, mà còn bền vững và an tâm trong những năm tháng về sau.</p>
          <a class="btn btn-primary" href={`${b}gioi-thieu/`}>Xem giới thiệu</a>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="wrap wide">
        <div>
          <h2>Bạn cần tư vấn sơn nhà, chống thấm?</h2>
          <p>Liên hệ nhanh qua Zalo hoặc gọi trực tiếp — khảo sát tận nơi.</p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={ZALO_HREF}>Nhắn Zalo</a>
          <a class="btn btn-ghost" href={PHONE_HREF}>Gọi {SO_TAM}</a>
        </div>
      </div>
    </section>

    <section class="trust-band">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Tiêu chí hoạt động</h2>
        <p class="trust-lead">Chúng tôi hoạt động với những tiêu chí rõ ràng từ tư vấn đến thi công để giữ chữ tín với khách hàng. Dưới đây là 6 giá trị khi chọn đồng hành cùng Archihouz.</p>
                        <div class="criteria">
          <article class="criteria-card">
          <div class="criteria-media">
            <picture>
              <source srcset={`${b}img/tieu-chi-01.webp`} type="image/webp" />
              <img src={`${b}img/tieu-chi-01.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="480" height="360" decoding="async" />
            </picture>
            <p class="criteria-cap">Ảnh demo / minh họa. Không phải công trình đã làm.</p>
          </div>
            <div class="criteria-body">
              <h3>01. Báo giá rõ ràng – Hạn chế tối đa phát sinh</h3>
              <p>Các hạng mục thi công, vật liệu, khối lượng và chi phí được trao đổi rõ ràng trước khi thực hiện. Ưu tiên minh bạch để khách hàng chủ động kiểm soát ngân sách.</p>
            </div>
          </article>
          <article class="criteria-card">
          <div class="criteria-media">
            <picture>
              <source srcset={`${b}img/tieu-chi-02.webp`} type="image/webp" />
              <img src={`${b}img/tieu-chi-02.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="480" height="360" decoding="async" />
            </picture>
            <p class="criteria-cap">Ảnh demo / minh họa. Không phải công trình đã làm.</p>
          </div>
            <div class="criteria-body">
              <h3>02. Cân đối giải pháp theo ngân sách</h3>
              <p>Tư vấn và cân đối phương án thi công, vật liệu và phạm vi công việc dựa trên ngân sách thực tế — hướng đến giải pháp phù hợp thay vì tư vấn vượt nhu cầu.</p>
            </div>
          </article>
          <article class="criteria-card">
          <div class="criteria-media">
            <picture>
              <source srcset={`${b}img/tieu-chi-03.webp`} type="image/webp" />
              <img src={`${b}img/tieu-chi-03.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="480" height="360" decoding="async" />
            </picture>
            <p class="criteria-cap">Ảnh demo / minh họa. Không phải công trình đã làm.</p>
          </div>
            <div class="criteria-body">
              <h3>03. Khảo sát thực tế – Tư vấn đúng nhu cầu</h3>
              <p>Khảo sát hiện trạng để xác định nguyên nhân, mức độ và đặc điểm từng khu vực. Đưa ra giải pháp phù hợp thay vì một phương án chung.</p>
            </div>
          </article>
          <article class="criteria-card">
          <div class="criteria-media">
            <picture>
              <source srcset={`${b}img/tieu-chi-04.webp`} type="image/webp" />
              <img src={`${b}img/tieu-chi-04.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="480" height="360" decoding="async" />
            </picture>
            <p class="criteria-cap">Ảnh demo / minh họa. Không phải công trình đã làm.</p>
          </div>
            <div class="criteria-body">
              <h3>04. Vật liệu rõ ràng – Lựa chọn có cơ sở</h3>
              <p>Tư vấn chủng loại, tính năng và phạm vi sử dụng của từng sản phẩm, giúp khách hàng hiểu mình đang đầu tư vào đâu.</p>
            </div>
          </article>
          <article class="criteria-card">
          <div class="criteria-media">
            <picture>
              <source srcset={`${b}img/tieu-chi-05.webp`} type="image/webp" />
              <img src={`${b}img/tieu-chi-05.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="480" height="360" decoding="async" />
            </picture>
            <p class="criteria-cap">Ảnh demo / minh họa. Không phải công trình đã làm.</p>
          </div>
            <div class="criteria-body">
              <h3>05. Thi công chú trọng nền tảng</h3>
              <p>Với chống thấm và sơn sửa, xử lý bề mặt trước khi hoàn thiện có vai trò quan trọng. Archihouz chú trọng từng bước xử lý để đảm bảo chất lượng và độ bền.</p>
            </div>
          </article>
          <article class="criteria-card">
          <div class="criteria-media">
            <picture>
              <source srcset={`${b}img/tieu-chi-06.webp`} type="image/webp" />
              <img src={`${b}img/tieu-chi-06.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="480" height="360" decoding="async" />
            </picture>
            <p class="criteria-cap">Ảnh demo / minh họa. Không phải công trình đã làm.</p>
          </div>
            <div class="criteria-body">
              <h3>06. Đồng hành có trách nhiệm</h3>
              <p>Theo sát từ khảo sát, tư vấn, báo giá đến thi công và hoàn thiện — trải nghiệm dịch vụ rõ ràng và an tâm.</p>
            </div>
          </article>
        </div>
</div>
    </section>

    <section class="alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Những con số ấn tượng</h2>
        <p>Với đội ngũ thi công giàu kinh nghiệm trong lĩnh vực sơn nhà và chống thấm, Archihouz đã đồng hành cùng hàng nghìn khách hàng trong việc làm đẹp và bảo vệ ngôi nhà. Chúng tôi đặt sự chỉn chu trong từng công đoạn, chất lượng công trình và sự hài lòng của khách hàng làm tiêu chuẩn cho mỗi dự án.</p>
        <div class="stats">
          <div class="stat"><span class="num">750+</span><span class="lbl">Công trình sơn nhà</span></div>
          <div class="stat"><span class="num">350+</span><span class="lbl">Công trình chống thấm</span></div>
          <div class="stat"><span class="num">1.000+</span><span class="lbl">Khách hàng đã tin chọn</span></div>
          <div class="stat"><span class="num">95%+</span><span class="lbl">Khách hàng hài lòng</span></div>
          <div class="stat"><span class="num">98%+</span><span class="lbl">Công trình đúng tiến độ</span></div>
        </div>
      </div>
    </section>

        <section class="process-band">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Quy trình làm việc</h2>
        <p class="process-lead">Từ tiếp nhận nhu cầu đến hoàn thiện — quy trình rõ ràng, dễ theo dõi.</p>
        <ol class="process-grid">
          <li class="process-card">
            <span class="process-num" aria-hidden="true">01</span>
            <div class="process-body">
              <div class="process-head">
                <img class="process-icon" src={`${b}img/quy-trinh/icon-buoc-01-tiep-nhan.webp`} alt="" width="40" height="40" />
                <h3>Tiếp nhận nhu cầu</h3>
              </div>
              <p>Lắng nghe mong muốn và vấn đề đang gặp để xác định đúng yêu cầu.</p>
            </div>
            <span class="process-arrow" aria-hidden="true"></span>
          </li>
          <li class="process-card">
            <span class="process-num" aria-hidden="true">02</span>
            <div class="process-body">
              <div class="process-head">
                <img class="process-icon" src={`${b}img/quy-trinh/icon-buoc-02-khao-sat.webp`} alt="" width="40" height="40" />
                <h3>Khảo sát &amp; đánh giá</h3>
              </div>
              <p>Kiểm tra hiện trạng bề mặt, xuống cấp hoặc thấm dột trước khi đề xuất.</p>
            </div>
            <span class="process-arrow" aria-hidden="true"></span>
          </li>
          <li class="process-card">
            <span class="process-num" aria-hidden="true">03</span>
            <div class="process-body">
              <div class="process-head">
                <img class="process-icon" src={`${b}img/quy-trinh/icon-buoc-03-tu-van.webp`} alt="" width="40" height="40" />
                <h3>Tư vấn giải pháp &amp; báo giá</h3>
              </div>
              <p>Phương án phù hợp kỹ thuật, vật liệu, thẩm mỹ và ngân sách. Báo giá rõ trước khi triển khai.</p>
            </div>
            <span class="process-arrow process-arrow-end" aria-hidden="true"></span>
          </li>
          <li class="process-card">
            <span class="process-num" aria-hidden="true">04</span>
            <div class="process-body">
              <div class="process-head">
                <img class="process-icon" src={`${b}img/quy-trinh/icon-buoc-04-chuan-bi.webp`} alt="" width="40" height="40" />
                <h3>Chuẩn bị &amp; thi công</h3>
              </div>
              <p>Chuẩn bị bề mặt, vật tư và khu vực theo đúng quy trình.</p>
            </div>
            <span class="process-arrow" aria-hidden="true"></span>
          </li>
          <li class="process-card">
            <span class="process-num" aria-hidden="true">05</span>
            <div class="process-body">
              <div class="process-head">
                <img class="process-icon" src={`${b}img/quy-trinh/icon-buoc-05-kiem-tra.webp`} alt="" width="40" height="40" />
                <h3>Kiểm tra &amp; nghiệm thu</h3>
              </div>
              <p>Kiểm tra chất lượng, hoàn thiện và nghiệm thu trước bàn giao.</p>
            </div>
            <span class="process-arrow" aria-hidden="true"></span>
          </li>
          <li class="process-card process-card-final">
            <span class="process-num" aria-hidden="true">06</span>
            <div class="process-body">
              <div class="process-head">
                <img class="process-icon" src={`${b}img/quy-trinh/icon-buoc-06-ban-giao.webp`} alt="" width="40" height="40" />
                <h3>Bàn giao &amp; bảo hành</h3>
              </div>
              <p>Bàn giao, hướng dẫn bảo quản và thực hiện bảo hành theo thỏa thuận.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

        <section class="situ-band alt">
      <div class="wrap wide">
        <span class="bar"></span>
        <h2>Minh họa tình huống thường gặp</h2>
        <div class="situ-grid" id="situ-grid" data-collapsed="true">
          <figure class="situ-item">
            <picture>
              <source srcset={`${b}img/gallery-01-o-vang.webp`} type="image/webp" />
              <img src={`${b}img/gallery-01-o-vang.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="400" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
          </figure>
          <figure class="situ-item">
            <picture>
              <source srcset={`${b}img/gallery-02-mua-tat.webp`} type="image/webp" />
              <img src={`${b}img/gallery-02-mua-tat.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="400" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
          </figure>
          <figure class="situ-item">
            <picture>
              <source srcset={`${b}img/gallery-03-lan-son.webp`} type="image/webp" />
              <img src={`${b}img/gallery-03-lan-son.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="400" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
          </figure>
          <figure class="situ-item">
            <picture>
              <source srcset={`${b}img/gallery-04-ba-tuong.webp`} type="image/webp" />
              <img src={`${b}img/gallery-04-ba-tuong.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="400" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
          </figure>
          <figure class="situ-item">
            <picture>
              <source srcset={`${b}img/gallery-05-khao-sat.webp`} type="image/webp" />
              <img src={`${b}img/gallery-05-khao-sat.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="400" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
          </figure>
          <figure class="situ-item">
            <picture>
              <source srcset={`${b}img/gallery-06-hoan-thien.webp`} type="image/webp" />
              <img src={`${b}img/gallery-06-hoan-thien.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="400" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
          </figure>
          <figure class="situ-item">
            <picture>
              <source srcset={`${b}img/stage-01-hien-trang.webp`} type="image/webp" />
              <img src={`${b}img/stage-01-hien-trang.jpg`} alt="Ảnh demo / minh họa. Không phải công trình đã làm." width="400" height="280" loading="lazy" decoding="async" />
            </picture>
            <figcaption>Ảnh demo / minh họa. Không phải công trình đã làm.</figcaption>
          </figure>
