---
import Base from '../layouts/Base.astro';
const title = 'Archihouz | Sơn sửa nhà và chống thấm TP.HCM';
const description = 'Archihouz nhận sơn nhà, sơn sửa nhà và chống thấm tại TP.HCM. Qua xem nhà rồi báo giá. Có hợp đồng.';
const b = import.meta.env.BASE_URL;
---
<Base title={title} description={description}>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1>Archihouz</h1>
        <p>Sơn sửa nhà và chống thấm tại TP.HCM. Qua xem nhà rồi báo giá. Có hợp đồng.</p>
        <div class="cards">
          <a class="card" href={`${b}chong-tham-nha-ve-sinh/`}>
            <h2>Nhà vệ sinh</h2>
            <p>Thấm sàn, ống, trần nhà dưới.</p>
          </a>
          <a class="card" href={`${b}chong-tham-san-thuong/`}>
            <h2>Sân thượng</h2>
            <p>Sân nứt, đọng nước.</p>
          </a>
          <a class="card" href={`${b}chong-tham-tuong/`}>
            <h2>Tường thấm</h2>
            <p>Tường ẩm, ố. Thử nước rồi giao.</p>
          </a>
          <a class="card" href={`${b}son-nha/`}>
            <h2>Sơn nhà</h2>
            <p>Gói sơn riêng. Xem nhà rồi báo giá.</p>
          </a>
          <a class="card" href={`${b}son-sua-nha/`}>
            <h2>Sơn sửa nhà</h2>
            <p>Nhà cũ cần sơn lại. Gói riêng.</p>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>
