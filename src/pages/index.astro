---
import Base from '../layouts/Base.astro';
const title = 'Archihouz | Chống thấm nhà phố TP.HCM';
const description = 'Archihouz nhận chống thấm nhà vệ sinh và sân thượng tại TP.HCM. Có hợp đồng. Thử nước rồi giao.';
---
<Base title={title} description={description}>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1>Archihouz</h1>
        <p>Chống thấm nhà phố tại TP.HCM. Có hợp đồng. Thử nước rồi giao.</p>
        <div class="cards">
          <a class="card" href="/chong-tham-nha-ve-sinh">Nhà vệ sinh đang thấm</a>
          <a class="card" href="/chong-tham-san-thuong">Sân thượng đang thấm</a>
        </div>
      </div>
    </section>
  </main>
</Base>
